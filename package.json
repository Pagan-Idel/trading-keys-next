{
  "name": "trading-keys",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "better-sqlite3": "^12.2.0",
    "cheerio": "^1.1.2",
    "cookies-next": "^4.2.1",
    "domhandler": "^5.0.3",
    "ioredis": "^5.4.1",
    "lightweight-charts": "^5.0.9",
    "next": "^13.5.11",
    "puppeteer": "^24.15.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "styled-components": "^5.1.34",
    "typescript": "^5.8.3",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "pi:control": "tsx pi/controlServer.ts",
    "pi:demo": "tsx runner/startRunner.ts --mode=demo",
    "pi:import-strategy": "tsx pi/importStrategy.ts",
    "pi:export-strategy": "tsx pi/exportStrategy.ts",
    "dev": "next dev -p 4000",
    "redis-windows": "redis-server C:/Documents/trading-keys-next/redis.windows.conf",
    "redis-ubuntu": "redis-server /etc/redis/redis.conf",
    "build": "next build",
    "start": "next start -p 4000",
    "build:threads": "tsc -p tsconfig.worker.json",
    "run:live": "npm run build:threads && tsx runner/startRunner.ts --mode=live",
    "run:demo": "npm run build:threads && tsx runner/startRunner.ts --mode=demo",
    "check:automation": "npm run build:threads && tsx runner/startRunner.ts --mode=demo --check",
    "test:controls": "tsx --test tests/goldilocksControlRegression.test.ts",
    "test:strategy": "tsx --test tests/chartViewport.test.ts tests/goldilocksControlRegression.test.ts tests/goldilocksStrategy.test.ts tests/priceStreamManager.test.ts",
    "test:automation": "tsx --test tests/autoResearchPiPromotion.test.ts tests/researchRecovery.test.ts tests/automationRuntime.test.ts tests/automationBootRecovery.test.ts tests/automationRecoveryPreflight.test.ts tests/workerStartupEligibility.test.ts tests/automationPromotionEvidence.test.ts tests/candleArchivePersistence.test.ts",
    "test:automation:integration": "tsx --test tests/automationControl.integration.test.ts tests/switchToLatest.integration.test.ts",
    "test:automation:e2e": "tsx --test tests/automation.e2e.test.ts",
    "validate:automation": "npm run test:automation && npm run test:automation:integration && npm run test:automation:e2e && npm run test:strategy && tsc --noEmit && npm run build:threads",
    "validate:pi:local": "npm run validate:automation && npm run build:pi-runtime",
    "benchmark:automation": "tsx scripts/benchmarkAutomation.ts",
    "test:deployment:docker": "docker run --rm -v \"%cd%:/repo:ro\" alpine:3.20 sh -lc \"apk add --no-cache bash shellcheck git shadow util-linux nodejs >/dev/null && bash -n /repo/pi/deploy.sh /repo/pi/verify-deployment.sh /repo/tests/deploymentScripts.test.sh && shellcheck /repo/pi/deploy.sh /repo/pi/verify-deployment.sh /repo/tests/deploymentScripts.test.sh && useradd -m tradingkeys && bash /repo/tests/deploymentScripts.test.sh /repo\"",
    "build:pi-runtime": "node scripts/buildPiRuntime.mjs",
    "benchmark:pi-runtime": "npm run build:pi-runtime && node scripts/benchmarkPiRuntime.mjs",
    "deploy:pi": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deployPi.ps1",
    "deploy:pi:candidate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deployPi.ps1 -Candidate",
    "research:auto": "tsx runner/startAutoResearch.ts",
    "start:prod": "npm run run:demo"
  },
  "eslintConfig": {
    "extends": "next/core-web-vitals"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/next": "^9.0.0",
    "@types/node": "^24.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@types/styled-components": "^5.1.34",
    "babel-plugin-styled-components": "^2.1.4",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "13.5.11",
    "tsx": "^4.19.4"
  }
}

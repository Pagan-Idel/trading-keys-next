PULSE_HOST=127.0.0.1
PULSE_PORT=4080
PULSE_CONTROL_TOKEN=replace-with-a-long-random-token
OANDA_DEMO_ACCOUNT_TOKEN=replace-me
OANDA_DEMO_ACCOUNT_ID=replace-me
OANDA_LIVE_ACCOUNT_TOKEN=
OANDA_LIVE_ACCOUNT_ID=
TRADING_KEYS_PI_RUNTIME=true
APPROVED_STRATEGY_SYNC_ENABLED=false
APPROVED_STRATEGY_SYNC_URL=https://authoritative.tailnet.ts.net/api/automation/approved-strategy
APPROVED_STRATEGY_SYNC_INTERVAL_MS=300000
APPROVED_STRATEGY_SYNC_TIMEOUT_MS=15000
# Scoped read-only token; set only in /etc/trading-keys/automation.env.
APPROVED_STRATEGY_SYNC_TOKEN=
# Read-only OANDA resilience (milliseconds; no credentials here).
OANDA_READ_TIMEOUT_MS=10000
OANDA_READ_RETRY_JITTER_MIN_MS=100
OANDA_READ_RETRY_JITTER_MAX_MS=500
OANDA_STREAM_IDLE_COOLDOWN_MS=5000

# Candle retention may be increased but never below the executable safety floor.
CANDLE_RETENTION_DAYS_M1=30
CANDLE_RETENTION_DAYS_M5=45
CANDLE_RETENTION_DAYS_M15=100
CANDLE_RETENTION_DAYS_H1=330
